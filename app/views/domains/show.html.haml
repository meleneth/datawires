= turbo_frame_tag "main_content" do
  = render TypographyComponent.new(as: :h1, text: @project_affordance&.title || "#{@domain.name} Domain", html_options: { class: "mb-4" })

  - if @project_affordance&.description.present?
    %p.mb-4.text-muted-foreground= @project_affordance.description

  - if @project_affordance&.default_board
    .mb-4
      = render ButtonComponent.new(href: board_path(@project_affordance.default_board), variant: :default) do
        Open project board
  - elsif @project_affordance
    .mb-4
      = button_to "Create project board", domain_project_boards_path(@domain), method: :post,
        class: "font-head inline-flex h-9 items-center rounded border-2 border-black bg-primary px-4 text-primary-foreground"

  - if @project_affordance
    .mb-4.flex.flex-wrap.gap-2
      = button_to "Edit project configuration",
        document_draft_path(@project_affordance.project_document),
        method: :post,
        form: { data: { turbo_frame: "main_content", turbo_action: "advance" } },
        class: "font-head inline-flex h-8 items-center rounded border-2 border-black bg-secondary px-3 text-sm shadow-sm"
      = render ButtonComponent.new(href: domain_sources_path(@domain), variant: :outline, size: :sm) do
        Sources
      = render ButtonComponent.new(href: domain_source_credentials_path(@domain), variant: :outline, size: :sm) do
        Credentials
      = render ButtonComponent.new(href: domain_metric_definitions_path(@domain), variant: :outline, size: :sm) do
        Metrics
      = render ButtonComponent.new(href: domain_query_definitions_path(@domain), variant: :outline, size: :sm) do
        Queries
  - else
    .mb-4
      = button_to "Enable project workspace",
        domain_project_affordance_path(@domain),
        method: :post,
        class: "font-head inline-flex h-9 items-center rounded border-2 border-black bg-primary px-4 text-sm text-primary-foreground shadow-sm"

  = render CardComponent.new(html_options: { class: "w-full" }) do
    = render CardContentComponent.new do
      .space-y-6
        - if notice.present?
          = render AlertComponent.new do
            = notice

        .space-y-1
          = render TypographyComponent.new(as: :muted, text: "Name")
          .font-head.text-lg.font-medium.text-foreground= @domain.name
          .text-sm.text-muted-foreground= [ @domain.public? ? "Public" : "Private", @domain.owner&.name ].compact.join(" by ")

        .flex.flex-wrap.items-center.gap-3
          = render ButtonComponent.new(href: edit_domain_path(@domain), variant: :secondary, size: :sm) do
            = @project_affordance ? "Edit project settings" : "Edit this domain"
          = render ButtonComponent.new(href: domains_path, variant: :outline, size: :sm) do
            Back to domains
          = render ButtonComponent.new(href: domain_archive_path(@domain), variant: :outline, size: :sm,
            html_options: { data: { turbo: false } }) do
            Export full archive
          = render ButtonComponent.new(href: domain_archive_path(@domain, operational_history: false), variant: :outline, size: :sm,
            html_options: { data: { turbo: false } }) do
            Export configuration only
          - if @domain.repository_mode?
            = render ButtonComponent.new(href: domain_domain_commits_path(@domain), variant: :outline, size: :sm) do
              Repository history
          = button_to "Archive this domain",
            @domain,
            method: :delete,
            form: { data: { turbo_confirm: "Are you sure? This domain will be hidden, but its data will be retained for recovery." } },
            class: "font-head inline-flex h-8 items-center justify-center rounded border-2 border-black bg-destructive px-3 text-sm font-medium text-destructive-foreground shadow-md transition-all hover:translate-y-1 hover:shadow-none"

        .space-y-3
          = render TypographyComponent.new(as: :h3, text: "Add schema")

          = form_with model: [@domain, @document], url: domain_schemas_path(@domain), class: "space-y-4" do |f|
            .space-y-1
              = render LabelComponent.new(text: "New schema name", for_id: "document_key")
              = render InputComponent.new(name: f.field_name(:key), value: @document.key, html_options: { id: "document_key", autofocus: true })
              - if @document.errors[:key].any?
                %p.text-sm.text-destructive= @document.errors[:key].to_sentence
            = render ButtonComponent.new(html_options: { type: :submit }) do
              Create

  - if @project_affordance && @project_navigation_groups.any?
    .mt-6.grid.gap-4.md:grid-cols-2
      - @project_navigation_groups.each do |group|
        = render CardComponent.new do
          = render CardContentComponent.new do
            = render TypographyComponent.new(as: :h3, text: group["title"])
            - if group["links"].any?
              %ul.mt-3.space-y-2
                - group["links"].each do |link|
                  %li
                    = link_to link["title"], link["href"], class: "font-head underline"
                    - if link["description"].present?
                      %p.text-sm.text-muted-foreground= link["description"]

  = render "domains/home_links"
  = render "domains/open_drafts"
  = render "domains/schemas"
