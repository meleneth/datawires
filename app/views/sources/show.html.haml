= turbo_frame_tag "main_content" do
  .flex.flex-wrap.items-center.justify-between.gap-3
    %div
      = render TypographyComponent.new(as: :h1, text: @source.body["title"])
      %p.text-sm.text-muted-foreground= "#{@source.adapter} · #{@source.status}"
    = button_to "Run now", source_source_runs_path(@source), method: :post,
      class: "font-head inline-flex h-9 items-center rounded border-2 border-black bg-primary px-4 text-primary-foreground"
    = button_to "Edit configuration", document_draft_path(@source.source_document), method: :post,
      class: "font-head inline-flex h-9 items-center rounded border-2 border-black bg-secondary px-4"
  - if @source.last_error.present?
    %p.mt-3.text-sm.text-destructive= @source.last_error
  .mt-4
    = form_with model: @source, url: source_path(@source), method: :patch, class: "flex items-end gap-2" do |form|
      %div
        = form.label :source_credential_id, "Credential", class: "block text-sm font-medium"
        = form.select :source_credential_id,
          options_for_select([["None", ""]] + @credentials.map { |credential| [credential.name, credential.id] }, @source.source_credential_id),
          {}, class: "rounded border-2 border-black bg-background px-3 py-2"
      = form.submit "Assign", class: "font-head h-10 rounded border-2 border-black bg-secondary px-4"
  .mt-6
    = render TypographyComponent.new(as: :h2, text: "Runs")
    %ul.mt-3.space-y-2
      - @runs.each do |run|
        %li.rounded.border-2.border-black.bg-card.p-3
          .font-head= "#{run.trigger} · #{run.status}"
          .text-xs.text-muted-foreground= "Config revision #{run.configuration_revision_id} · #{run.observation_count} observations"
          - if run.error_message.present?
            .text-sm.text-destructive= run.error_message
