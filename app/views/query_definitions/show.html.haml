= turbo_frame_tag "main_content" do
  = render TypographyComponent.new(as: :h1, text: @query.body["title"])
  %p.text-muted-foreground= @query.body["description"]
  %pre.mt-4.overflow-auto.rounded.border-2.border-black.bg-card.p-4= JSON.pretty_generate(@query.body)
  = button_to "Edit versioned definition", document_draft_path(@query.query_document), method: :post,
    class: "mt-4 font-head rounded border-2 border-black bg-secondary px-4 py-2"
