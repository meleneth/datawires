= turbo_frame_tag "main_content" do
  .mb-4.flex.flex-wrap.items-start.justify-between.gap-3
    %div
      = render TypographyComponent.new(as: :h1, text: @projection.title)
      - if @projection.description.present?
        = render TypographyComponent.new(as: :muted, text: @projection.description)
    = link_to "Schema workshop",
      schema_path(@schema_wrapper, workshop: 1),
      data: { turbo_frame: "main_content", turbo_action: "advance" },
      class: "font-head inline-flex h-8 items-center justify-center rounded border-2 border-black bg-secondary px-3 text-sm font-medium text-secondary-foreground shadow-md transition-all hover:translate-y-1 hover:shadow-none"

  - if @projection.actions.any?
    .mb-6.flex.flex-wrap.gap-2
      - @projection.actions.each do |action|
        %span.rounded.border-2.border-black.bg-muted.px-3.py-2.text-sm
          = action.title

  - if @projection.sections.any?
    .grid.gap-4
      - @projection.sections.each do |section|
        = render CardComponent.new do
          = render CardContentComponent.new do
            = render TypographyComponent.new(as: :h2, text: section.title)
            - if section.description.present?
              = render TypographyComponent.new(as: :muted, text: section.description)
  - else
    = render CardComponent.new do
      = render CardContentComponent.new do
        = render TypographyComponent.new(as: :muted, text: "This board has no sections yet.")
