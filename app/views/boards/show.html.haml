= turbo_frame_tag "main_content" do
  .mb-4.flex.flex-wrap.items-start.justify-between.gap-3
    %div
      = render TypographyComponent.new(as: :h1, text: @projection.title)
      - if @projection.description.present?
        = render TypographyComponent.new(as: :muted, text: @projection.description)
    = link_to "Schema workshop",
      schema_path(@schema_wrapper, workshop: 1),
      data: { turbo_frame: "main_content", turbo_action: "advance" },
      class: "font-head inline-flex h-8 items-center justify-center rounded border-2 border-black bg-secondary px-3 text-sm font-medium text-secondary-foreground shadow-md transition-all hover:translate-y-1 hover:shadow-none"

  - if @sibling_boards.any?
    .mb-4.flex.flex-wrap.items-center.gap-2
      %span.text-sm.text-muted-foreground Workspaces:
      - @sibling_boards.each do |board|
        = link_to board.title,
          board_path(board),
          data: { turbo_frame: "main_content", turbo_action: "advance" },
          class: "font-head inline-flex h-8 items-center rounded border-2 border-black bg-secondary px-3 text-sm shadow-sm"

  - if @action_resolutions.reject(&:hidden?).any?
    .mb-6.flex.flex-wrap.gap-2
      - @action_resolutions.reject(&:hidden?).each do |resolution|
        - if resolution.available?
          - if resolution.domain_command
            = link_to resolution.action.title,
              board_action_form_path(@board, resolution.action.id),
              data: { turbo_frame: "main_content", turbo_action: "advance" },
              class: "font-head inline-flex h-10 items-center justify-center rounded border-2 border-black bg-primary px-4 py-2 font-medium text-primary-foreground shadow-md transition-all hover:translate-y-1 hover:shadow-none"
          - else
            = button_to resolution.action.title,
              board_action_path(@board, resolution.action.id),
              method: :post,
              class: "font-head inline-flex h-10 items-center justify-center rounded border-2 border-black bg-primary px-4 py-2 font-medium text-primary-foreground shadow-md transition-all hover:translate-y-1 hover:shadow-none"
        - else
          %span.inline-flex.flex-col.rounded.border-2.border-black.bg-muted.px-3.py-2.text-sm.text-muted-foreground
            %span.font-head= resolution.action.title
            %span.text-xs= resolution.reason

  - if @projection.columns.any?
    %div{ class: @layout_provider.container_class }
      - @projection.columns.each do |column|
        %section{ class: @layout_provider.column_class }
          = render CardComponent.new do
            = render CardContentComponent.new do
              = render TypographyComponent.new(as: :h2, text: column.title)
              .mt-3.space-y-3
                - column.cards.each do |card|
                  - result = @card_results[card.id]
                  .rounded.border-2.border-black.bg-background.p-3.shadow-sm
                    .font-head.font-medium= result&.title || card.title
                    - if result&.description.present?
                      %p.mt-1.text-sm.text-muted-foreground= result.description
                    - if result&.available?
                      - if result.partial
                        = render result.partial, result:
                      - elsif result.href
                        = link_to "Open", result.href,
                          data: { turbo_frame: "main_content", turbo_action: "advance" },
                          class: "mt-3 inline-flex font-head text-sm underline"
                      - elsif result.action_path
                        = button_to result.title,
                          result.action_path,
                          method: result.action_method,
                          class: "mt-3 inline-flex h-8 items-center rounded border-2 border-black bg-primary px-3 font-head text-sm text-primary-foreground"
                    - else
                      %p.mt-2.text-sm.text-destructive= result&.description || "Card provider is unavailable."

  - if @projection.sections.any?
    .grid.gap-4
      - @projection.sections.each do |section|
        = render CardComponent.new do
          = render CardContentComponent.new do
            = render TypographyComponent.new(as: :h2, text: section.title)
            - if section.description.present?
              = render TypographyComponent.new(as: :muted, text: section.description)
            - result = @section_results[section.id]
            - if result&.error
              %p.mt-2.text-sm.text-destructive= result.error
            - elsif result
              - if result.respond_to?(:rows) && result.rows.any?
                %ul.mt-3.space-y-2
                  - result.rows.each do |row|
                    %li.rounded.border-2.border-black.bg-background.px-3.py-2
                      .font-head.font-medium= row.label
                      - row.details.each do |detail|
                        .text-xs.text-muted-foreground= detail
              - elsif result.respond_to?(:documents) && result.documents.any?
                %ul.mt-3.space-y-2
                  - result.documents.each do |document|
                    %li.rounded.border-2.border-black.bg-background.px-3.py-2
                      - href = result.view_affordance ? document_view_affordance_path(document, result.view_affordance) : document_path(document)
                      = link_to href,
                        data: { turbo_frame: "main_content", turbo_action: "advance" },
                        class: "block transition-colors hover:underline" do
                        .font-head.font-medium= document.title.presence || document.key
                        - if document.key.present?
                          .text-xs.text-muted-foreground= document.key
              - elsif result.respond_to?(:rows) || result.respond_to?(:documents)
                = render TypographyComponent.new(as: :muted, text: result.empty_state, html_options: { class: "mt-2" })
  - else
    = render CardComponent.new do
      = render CardContentComponent.new do
        = render TypographyComponent.new(as: :muted, text: "This board has no sections yet.")
