{
  "version": 1,
  "name": "Datawires Meeting Lifecycle",
  "role_capabilities": {
    "submit_proposal": ["member", "chair", "secretary", "temporary_chair"],
    "request_recognition": ["member", "chair", "secretary", "temporary_chair"],
    "introduce_question": ["member", "chair", "secretary", "temporary_chair"],
    "move_amendment": ["member", "chair", "secretary", "temporary_chair"],
    "second_question": ["member", "chair", "secretary", "temporary_chair"],
    "create_meeting": ["chair", "secretary"],
    "schedule_proposal": ["chair", "secretary"],
    "open_meeting": ["chair", "temporary_chair"],
    "record_minutes": ["secretary"],
    "vote": ["member", "chair", "secretary", "temporary_chair"],
    "chair_action": ["chair", "temporary_chair"],
    "administer_board": ["chair", "secretary"]
  },
  "commands": {
    "open_meeting": {
      "capability": "open_meeting",
      "allowed_statuses": ["scheduled"],
      "event_type": "MeetingOpened",
      "event_version": 1,
      "payload": {},
      "effects": [
        {"op": "set", "field": "status", "value": {"source": "literal", "value": "open"}},
        {"op": "set", "field": "opened_at", "value": {"source": "timestamp"}}
      ]
    },
    "establish_attendance": {
      "capability": "chair_action",
      "allowed_statuses": ["open"],
      "event_type": "AttendanceEstablished",
      "event_version": 1,
      "payload": {"actor_ids": "array"},
      "effects": [
        {"op": "set", "field": "attendance_actor_ids", "value": {"source": "payload", "key": "actor_ids"}}
      ]
    },
    "establish_quorum": {
      "capability": "chair_action",
      "allowed_statuses": ["open"],
      "event_type": "QuorumEstablished",
      "event_version": 1,
      "payload": {"present": "boolean"},
      "effects": [
        {"op": "set", "field": "quorum", "value": {"source": "payload"}}
      ]
    },
    "adjourn_meeting": {
      "capability": "chair_action",
      "allowed_statuses": ["open"],
      "event_type": "MeetingAdjourned",
      "event_version": 1,
      "effects": [
        {"op": "set", "field": "status", "value": {"source": "literal", "value": "adjourned"}},
        {"op": "set", "field": "adjourned_at", "value": {"source": "timestamp"}},
        {"op": "set", "field": "recognition_requests", "value": {"source": "literal", "value": []}},
        {"op": "merge_last", "field": "floor_history", "when": {"op": "present", "field": "floor_holder_id"}, "value": {
          "ended_at": {"source": "timestamp_iso8601"},
          "end_reason": {"source": "literal", "value": "meeting_adjourned"}
        }},
        {"op": "set", "field": "floor_holder_id", "value": {"source": "literal", "value": null}},
        {"op": "set", "field": "floor_reason", "value": {"source": "literal", "value": null}}
      ]
    },
    "request_recognition": {
      "capability": "request_recognition",
      "allowed_statuses": ["open"],
      "event_type": "RecognitionRequested",
      "event_version": 1,
      "conditions": [
        {
          "op": "collection_excludes",
          "field": "recognition_requests",
          "match_field": "actor_id",
          "value": {"source": "actor_id"},
          "reason": "The actor already has a recognition request."
        }
      ],
      "event_payload": {"actor_id": {"source": "actor_id"}},
      "effects": [
        {"op": "append", "field": "recognition_requests", "value": {
          "actor_id": {"source": "actor_id"},
          "reason": {"source": "payload", "key": "reason"},
          "requested_at": {"source": "timestamp_iso8601"}
        }}
      ]
    },
    "recognize_member": {
      "capability": "chair_action",
      "allowed_statuses": ["open"],
      "event_type": "MemberRecognized",
      "event_version": 1,
      "payload": {"actor_id": "uuid"},
      "conditions": [
        {"op": "blank", "field": "floor_holder_id", "reason": "Another actor already holds the floor."},
        {
          "op": "collection_includes",
          "field": "recognition_requests",
          "match_field": "actor_id",
          "value": {"source": "payload", "key": "actor_id"},
          "reason": "The actor has not requested recognition."
        }
      ],
      "effects": [
        {"op": "remove_matching", "field": "recognition_requests", "match_field": "actor_id", "value": {"source": "payload", "key": "actor_id"}},
        {"op": "set", "field": "floor_holder_id", "value": {"source": "payload", "key": "actor_id"}},
        {"op": "set", "field": "floor_reason", "value": {"source": "payload", "key": "reason"}},
        {"op": "append", "field": "floor_history", "value": {
          "actor_id": {"source": "payload", "key": "actor_id"},
          "reason": {"source": "payload", "key": "reason"},
          "granted_at": {"source": "timestamp_iso8601"}
        }}
      ]
    },
    "relinquish_floor": {
      "capability": "request_recognition",
      "allowed_statuses": ["open"],
      "event_type": "FloorRelinquished",
      "event_version": 1,
      "conditions": [
        {
          "op": "equals",
          "field": "floor_holder_id",
          "value": {"source": "actor_id"},
          "reason": "Only the current floor holder may relinquish the floor."
        }
      ],
      "event_payload": {"actor_id": {"source": "actor_id"}},
      "effects": [
        {"op": "merge_last", "field": "floor_history", "value": {
          "ended_at": {"source": "timestamp_iso8601"},
          "end_reason": {"source": "payload_or_literal", "key": "reason", "value": "relinquished"}
        }},
        {"op": "set", "field": "floor_holder_id", "value": {"source": "literal", "value": null}},
        {"op": "set", "field": "floor_reason", "value": {"source": "literal", "value": null}}
      ]
    },
    "schedule_proposal": {
      "capability": "schedule_proposal",
      "allowed_statuses": ["scheduled", "open"],
      "event_type": "ProposalScheduled",
      "event_version": 1,
      "payload": {"proposal_id": "uuid"},
      "resources": {
        "proposal": {"type": "proposal", "id": {"source": "payload", "key": "proposal_id"}}
      },
      "conditions": [
        {
          "op": "resource_equals",
          "resource": "proposal",
          "attribute": "body_id",
          "value": {"source": "meeting_body_id"},
          "reason": "Proposal belongs to a different Body."
        },
        {
          "op": "collection_excludes",
          "field": "scheduled_proposals",
          "match_field": "proposal_id",
          "value": {"source": "resource", "resource": "proposal", "attribute": "id"},
          "reason": "Proposal is already scheduled for this Meeting."
        }
      ],
      "event_payload": {
        "proposal_id": {"source": "resource", "resource": "proposal", "attribute": "id"},
        "proposal_revision_id": {"source": "resource", "resource": "proposal", "attribute": "submitted_revision_id"}
      },
      "effects": [
        {"op": "append", "field": "scheduled_proposals", "value": {
          "proposal_id": {"source": "resource", "resource": "proposal", "attribute": "id"},
          "proposal_revision_id": {"source": "resource", "resource": "proposal", "attribute": "submitted_revision_id"},
          "scheduled_by_id": {"source": "actor_id"}
        }}
      ]
    },
    "introduce_question_from_proposal": {
      "capability": "introduce_question",
      "allowed_statuses": ["open"],
      "event_type": "MotionMade",
      "event_version": 1,
      "payload": {"proposal_id": "uuid"},
      "resources": {
        "proposal": {"type": "proposal", "id": {"source": "payload", "key": "proposal_id"}}
      },
      "conditions": [
        {
          "op": "equals",
          "field": "floor_holder_id",
          "value": {"source": "actor_id"},
          "reason": "The actor must hold the floor."
        },
        {
          "op": "collection_includes",
          "field": "scheduled_proposals",
          "match_field": "proposal_id",
          "value": {"source": "resource", "resource": "proposal", "attribute": "id"},
          "reason": "The Proposal is not scheduled for this Meeting."
        },
        {
          "op": "stack_empty",
          "field": "pending_question_stack",
          "reason": "Another question is already pending."
        }
      ],
      "event_payload": {
        "motion_id": {"source": "command_id"},
        "question_id": {"source": "derived_id", "name": "pending_question"},
        "proposal_id": {"source": "resource", "resource": "proposal", "attribute": "id"},
        "proposal_revision_id": {"source": "resource", "resource": "proposal", "attribute": "submitted_revision_id"},
        "content": {"source": "resource", "resource": "proposal", "attribute": "submitted_content"},
        "made_by_id": {"source": "actor_id"},
        "made_at": {"source": "timestamp_iso8601"}
      },
      "effects": [
        {"op": "stack_push", "field": "pending_question_stack", "value": {
          "id": {"source": "derived_id", "name": "pending_question"},
          "motion_id": {"source": "command_id"},
          "kind": {"source": "literal", "value": "main"},
          "version": {"source": "literal", "value": 1},
          "status": {"source": "literal", "value": "introduced"},
          "proposal_id": {"source": "resource", "resource": "proposal", "attribute": "id"},
          "proposal_revision_id": {"source": "resource", "resource": "proposal", "attribute": "submitted_revision_id"},
          "content": {"source": "resource", "resource": "proposal", "attribute": "submitted_content"},
          "made_by_id": {"source": "actor_id"},
          "made_at": {"source": "timestamp_iso8601"}
        }}
      ]
    },
    "second_pending_question": {
      "capability": "second_question",
      "allowed_statuses": ["open"],
      "event_type": "MotionSeconded",
      "event_version": 1,
      "conditions": [
        {
          "op": "stack_present",
          "field": "pending_question_stack",
          "reason": "There is no pending question to second."
        },
        {
          "op": "stack_top_equals",
          "field": "pending_question_stack",
          "match_field": "status",
          "value": {"source": "literal", "value": "introduced"},
          "reason": "The immediately pending question is not awaiting a second."
        },
        {
          "op": "stack_top_not_equals",
          "field": "pending_question_stack",
          "match_field": "made_by_id",
          "value": {"source": "actor_id"},
          "reason": "The maker may not second the same motion."
        }
      ],
      "event_payload": {
        "motion_id": {"source": "stack_top", "field": "pending_question_stack", "attribute": "motion_id"},
        "question_id": {"source": "stack_top", "field": "pending_question_stack", "attribute": "id"},
        "seconded_by_id": {"source": "actor_id"},
        "seconded_at": {"source": "timestamp_iso8601"}
      },
      "effects": [
        {"op": "stack_merge_top", "field": "pending_question_stack", "value": {
          "status": {"source": "literal", "value": "seconded"},
          "seconded_by_id": {"source": "actor_id"},
          "seconded_at": {"source": "timestamp_iso8601"}
        }}
      ]
    },
    "rule_pending_question_in_order": {
      "capability": "chair_action",
      "allowed_statuses": ["open"],
      "event_type": "MotionRuledInOrder",
      "event_version": 1,
      "payload": {"rationale": "string", "authority": "string"},
      "conditions": [
        {
          "op": "stack_present",
          "field": "pending_question_stack",
          "reason": "There is no pending question to rule on."
        },
        {
          "op": "stack_top_equals",
          "field": "pending_question_stack",
          "match_field": "status",
          "value": {"source": "literal", "value": "seconded"},
          "reason": "The immediately pending question is not awaiting a ruling."
        }
      ],
      "event_payload": {
        "motion_id": {"source": "stack_top", "field": "pending_question_stack", "attribute": "motion_id"},
        "question_id": {"source": "stack_top", "field": "pending_question_stack", "attribute": "id"},
        "rationale": {"source": "payload", "key": "rationale"},
        "authority": {"source": "payload", "key": "authority"},
        "ruled_by_id": {"source": "actor_id"},
        "ruled_at": {"source": "timestamp_iso8601"}
      },
      "effects": [
        {"op": "stack_merge_top", "field": "pending_question_stack", "value": {
          "status": {"source": "literal", "value": "in_order"},
          "ruling": {"source": "literal", "value": "in_order"},
          "ruling_rationale": {"source": "payload", "key": "rationale"},
          "ruling_authority": {"source": "payload", "key": "authority"},
          "ruled_by_id": {"source": "actor_id"},
          "ruled_at": {"source": "timestamp_iso8601"}
        }}
      ]
    },
    "rule_pending_question_out_of_order": {
      "capability": "chair_action",
      "allowed_statuses": ["open"],
      "event_type": "MotionRuledOutOfOrder",
      "event_version": 1,
      "payload": {"rationale": "string", "authority": "string"},
      "conditions": [
        {
          "op": "stack_present",
          "field": "pending_question_stack",
          "reason": "There is no pending question to rule on."
        },
        {
          "op": "stack_top_equals",
          "field": "pending_question_stack",
          "match_field": "status",
          "value": {"source": "literal", "value": "seconded"},
          "reason": "The immediately pending question is not awaiting a ruling."
        }
      ],
      "event_payload": {
        "motion_id": {"source": "stack_top", "field": "pending_question_stack", "attribute": "motion_id"},
        "question_id": {"source": "stack_top", "field": "pending_question_stack", "attribute": "id"},
        "rationale": {"source": "payload", "key": "rationale"},
        "authority": {"source": "payload", "key": "authority"},
        "ruled_by_id": {"source": "actor_id"},
        "ruled_at": {"source": "timestamp_iso8601"}
      },
      "effects": [
        {"op": "stack_pop", "field": "pending_question_stack"}
      ]
    },
    "open_debate_on_pending_question": {
      "capability": "chair_action",
      "allowed_statuses": ["open"],
      "event_type": "DebateOpened",
      "event_version": 1,
      "conditions": [
        {
          "op": "stack_present",
          "field": "pending_question_stack",
          "reason": "There is no pending question for debate."
        },
        {
          "op": "stack_top_equals",
          "field": "pending_question_stack",
          "match_field": "status",
          "value": {"source": "literal", "value": "in_order"},
          "reason": "The immediately pending question is not ready for debate."
        }
      ],
      "event_payload": {
        "motion_id": {"source": "stack_top", "field": "pending_question_stack", "attribute": "motion_id"},
        "question_id": {"source": "stack_top", "field": "pending_question_stack", "attribute": "id"},
        "opened_by_id": {"source": "actor_id"},
        "opened_at": {"source": "timestamp_iso8601"}
      },
      "effects": [
        {"op": "stack_merge_top", "field": "pending_question_stack", "value": {
          "status": {"source": "literal", "value": "debate_open"},
          "debate_opened_by_id": {"source": "actor_id"},
          "debate_opened_at": {"source": "timestamp_iso8601"}
        }}
      ]
    },
    "move_amendment": {
      "capability": "move_amendment",
      "allowed_statuses": ["open"],
      "event_type": "AmendmentMoved",
      "event_version": 1,
      "payload": {"operation": "object"},
      "conditions": [
        {
          "op": "equals",
          "field": "floor_holder_id",
          "value": {"source": "actor_id"},
          "reason": "The actor must hold the floor."
        },
        {
          "op": "stack_top_equals",
          "field": "pending_question_stack",
          "match_field": "kind",
          "value": {"source": "literal", "value": "main"},
          "reason": "Only the initial first-degree amendment slice is available."
        },
        {
          "op": "stack_top_equals",
          "field": "pending_question_stack",
          "match_field": "status",
          "value": {"source": "literal", "value": "debate_open"},
          "reason": "The immediately pending question is not open to amendment."
        }
      ],
      "event_payload": {
        "amendment_id": {"source": "command_id"},
        "question_id": {"source": "derived_id", "name": "amendment_question"},
        "parent_question_id": {"source": "stack_top", "field": "pending_question_stack", "attribute": "id"},
        "parent_version": {"source": "stack_top", "field": "pending_question_stack", "attribute": "version"},
        "operation": {"source": "payload", "key": "operation"},
        "proposed_content": {
          "source": "document_operation",
          "document": {"source": "stack_top", "field": "pending_question_stack", "attribute": "content"},
          "operation": {"source": "payload", "key": "operation"},
          "current_version": {"source": "stack_top", "field": "pending_question_stack", "attribute": "version"}
        },
        "moved_by_id": {"source": "actor_id"},
        "moved_at": {"source": "timestamp_iso8601"}
      },
      "effects": [
        {"op": "stack_push", "field": "pending_question_stack", "value": {
          "id": {"source": "derived_id", "name": "amendment_question"},
          "amendment_id": {"source": "command_id"},
          "kind": {"source": "literal", "value": "amendment"},
          "degree": {"source": "literal", "value": 1},
          "version": {"source": "literal", "value": 1},
          "status": {"source": "literal", "value": "introduced"},
          "parent_question_id": {"source": "stack_top", "field": "pending_question_stack", "attribute": "id"},
          "parent_version": {"source": "stack_top", "field": "pending_question_stack", "attribute": "version"},
          "operation": {"source": "payload", "key": "operation"},
          "content": {
            "source": "document_operation",
            "document": {"source": "stack_top", "field": "pending_question_stack", "attribute": "content"},
            "operation": {"source": "payload", "key": "operation"},
            "current_version": {"source": "stack_top", "field": "pending_question_stack", "attribute": "version"}
          },
          "moved_by_id": {"source": "actor_id"},
          "moved_at": {"source": "timestamp_iso8601"}
        }}
      ]
    }
  }
}
