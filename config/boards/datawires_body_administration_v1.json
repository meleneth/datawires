{
  "version": 1,
  "title": "Body Administration",
  "description": "Memberships, scoped roles, effective periods, and identity relationships.",
  "layout": {
    "columns": 2
  },
  "sections": [
    {
      "id": "memberships",
      "kind": "membership_collection",
      "title": "Membership history",
      "config": {
        "limit": 100,
        "empty_state": "No memberships are available to administer."
      }
    },
    {
      "id": "role-assignments",
      "kind": "role_assignment_collection",
      "title": "Scoped role history",
      "config": {
        "limit": 100,
        "empty_state": "No role assignments are available to administer."
      }
    }
  ],
  "actions": [
    {
      "id": "add-member",
      "kind": "invoke_command",
      "title": "Add member",
      "config": {
        "command": "add_membership",
        "when_denied": "disabled"
      }
    },
    {
      "id": "assign-role",
      "kind": "invoke_command",
      "title": "Assign role",
      "config": {
        "command": "assign_role",
        "when_denied": "disabled"
      }
    },
    {
      "id": "end-membership",
      "kind": "invoke_command",
      "title": "End membership",
      "config": {
        "command": "end_membership",
        "when_denied": "disabled"
      }
    },
    {
      "id": "end-role-assignment",
      "kind": "invoke_command",
      "title": "End role assignment",
      "config": {
        "command": "end_role_assignment",
        "when_denied": "disabled"
      }
    }
  ]
}
